    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order (queue, base64-encoded by QueueClient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerName\": \"Test Customer\",\n  \"selectedItemSKUs\": [\n    \"COF-001\",\n    \"COF-002\"\n  ],\n  \"totalPrice\": 79.5,\n  \"orderTimestamp\": \"2026-10-10T09:30:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderId', 'ORD-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order queued (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Place Order - invalid (no SKUs, negative price) -> 400",
          "request": {

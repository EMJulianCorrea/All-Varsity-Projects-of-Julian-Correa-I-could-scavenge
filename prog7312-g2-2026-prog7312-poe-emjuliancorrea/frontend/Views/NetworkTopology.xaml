<Page x:Class="Smart_X.frontend.Views.NetworkTopology"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Network Topology and Mesh Routing">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Background="{StaticResource SurfaceBrush}">
      <TextBlock Text="Network Topology &amp; Mesh Routing" FontSize="25" FontWeight="Bold" Foreground="{StaticResource BrandDarkBrush}"/>
      <TextBlock Text="Live mesh overview, indexed telemetry history, connectivity analysis and energy-aware routing."
                 Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,18"/>
      <UniformGrid Columns="4" Margin="0,0,0,16">
        <Border Background="White" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="REGISTERED NODES" Foreground="Gray" FontSize="11"/><TextBlock x:Name="NodeCountText" Text="—" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="ONLINE DEVICES" Foreground="Gray" FontSize="11"/><TextBlock x:Name="OnlineCountText" Text="—" FontSize="25" FontWeight="Bold" Foreground="#238653"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="OFFLINE / DOWN" Foreground="Gray" FontSize="11"/><TextBlock x:Name="DownCountText" Text="—" FontSize="25" FontWeight="Bold" Foreground="#C43D3D"/></StackPanel></Border>
        <Border Background="White" CornerRadius="8" Padding="14" Margin="4"><StackPanel><TextBlock Text="MST ENERGY COST" Foreground="Gray" FontSize="11"/><TextBlock x:Name="EnergyText" Text="—" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
      </UniformGrid>
      <TabControl>
        <TabItem Header="Network dashboard">
          <StackPanel Margin="12">
            <DockPanel Margin="0,0,0,8">
              <Button Content="Refresh network" Click="Refresh_Click" Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right"/>
              <TextBlock Text="Physical mesh graph (nodes and wireless links)" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Canvas x:Name="NetworkCanvas" Height="290" Background="#F7F9FC" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,12">
              <TextBlock Text="● Server" Foreground="#315E8A" Margin="0,0,18,0"/>
              <TextBlock Text="● Gateway" Foreground="#238653" Margin="0,0,18,0"/>
              <TextBlock Text="● Online ESP32" Foreground="#477CCB" Margin="0,0,18,0"/>
              <TextBlock Text="● Offline ESP32" Foreground="#C43D3D" Margin="0,0,18,0"/>
              <TextBlock Text="━ MST link" Foreground="#D18A18"/>
            </WrapPanel>
            <Border Background="#EEF4FA" CornerRadius="8" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Worked routing example" FontWeight="Bold" Foreground="#23496D"/>
                <TextBlock Text="For a sample mesh, suppose ESP32-A → Gateway costs 2.0, ESP32-B → Gateway costs 1.0, Gateway → Server costs 1.5, and ESP32-A → ESP32-B costs 0.8. Prim selects the 0.8, 1.0 and 1.5 links (total 3.3), rather than forwarding every sensor directly to the server. Actual routes below use the configured graph and measured link costs." TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#40566B"/>
              </StackPanel>
            </Border>
            <DataGrid x:Name="TopologyGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Device / Node" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Wireless connections" FontWeight="SemiBold" Margin="0,14,0,6"/>
            <DataGrid x:Name="EdgesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*"/>
                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="*"/>
                <DataGridTextColumn Header="Energy cost (relative)" Binding="{Binding EnergyCost}" Width="180"/>
                <DataGridTextColumn Header="Link" Binding="{Binding Status}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="NetworkStatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Historical telemetry (BST)">
          <StackPanel Margin="12">
            <TextBlock Text="Select a sensor and a timestamp range to view all the logs that match your input"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
            <WrapPanel VerticalAlignment="Center">
              <StackPanel Width="230" Margin="0,0,12,0"><TextBlock Text="Sensor" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="SensorCombo" DisplayMemberPath="Id"/></StackPanel>
              <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="From date" Style="{StaticResource FieldLabelStyle}"/><DatePicker x:Name="FromDate"/></StackPanel>
              <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="To date" Style="{StaticResource FieldLabelStyle}"/><DatePicker x:Name="ToDate"/></StackPanel>
              <Button Content="Query range" Click="QueryHistory_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
            </WrapPanel>
            <TextBlock x:Name="HistoryStatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Telemetry trend for selected range" FontWeight="SemiBold" Margin="4,0,0,4"/>
                <Canvas x:Name="TelemetryChart" Height="150" Background="#FAFBFD"/>
              </StackPanel>
            </Border>
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="330">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="220"/>
                <DataGridTextColumn Header="Sensor" Binding="{Binding SensorId}" Width="150"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
                <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="100"/>
                <DataGridCheckBoxColumn Header="Anomaly" Binding="{Binding IsAnomalous}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </TabItem>
        <TabItem Header="DFS connectivity">
          <StackPanel Margin="12">
            <TextBlock Text="Depth-First Search traverses active wireless links from the selected gateway and reports devices reachable from it, including offline devices encountered in the component."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
            <WrapPanel>
              <TextBlock Text="Gateway:" VerticalAlignment="Center" Margin="0,0,8,12"/>
              <ComboBox x:Name="GatewayCombo" Width="260" DisplayMemberPath="Id" Margin="0,0,12,12"/>
              <Button Content="Run DFS" Click="Analyze_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"/>
            </WrapPanel>
            <TextBlock x:Name="DfsResultText" Text="Run DFS to inspect gateway connectivity." TextWrapping="Wrap" FontSize="14"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Prim's energy routing">
          <StackPanel Margin="12">
            <TextBlock Text="Prim's algorithm computes a minimum spanning forest over active wireless links using configured relative energy costs. This is a low-cost network backbone, not a guarantee of a single end-to-end route when the graph is disconnected."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
            <Button Content="Calculate MST" Click="Analyze_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="MstResultText" Text="Calculate the MST to view selected links." Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14"/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</Page>

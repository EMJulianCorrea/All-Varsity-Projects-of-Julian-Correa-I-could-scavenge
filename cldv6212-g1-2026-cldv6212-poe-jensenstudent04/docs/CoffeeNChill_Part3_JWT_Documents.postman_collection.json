{
  "info": {
    "name": "CoffeeNChill Part 3 - Maheshen JWT and Documents",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl to the live gateway URL. Adjust auth request bodies to the actual lecturer gateway DTOs. Do not commit real credentials or tokens."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "documentFileName",
      "value": "sample.pdf"
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.test\",\n  \"password\": \"ChangeMe123!\"\n}"
            }
          }
        },
        {
          "name": "Login customer (save token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.test\",\n  \"password\": \"ChangeMe123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "const token = response.token || response.accessToken || response.jwt;",
                  "if (token) pm.collectionVariables.set(\"token\", token);",
                  "else console.warn(\"Check login response property for JWT token\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Login staff (save token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@example.test\",\n  \"password\": \"REPLACE_LOCALLY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "const token = response.token || response.accessToken || response.jwt;",
                  "if (token) pm.collectionVariables.set(\"token\", token);",
                  "else console.warn(\"Check login response property for JWT token\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (save token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.test\",\n  \"password\": \"REPLACE_LOCALLY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "const token = response.token || response.accessToken || response.jwt;",
                  "if (token) pm.collectionVariables.set(\"token\", token);",
                  "else console.warn(\"Check login response property for JWT token\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Documents - authorized",
      "item": [
        {
          "name": "List documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Download document",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/documents/{{documentFileName}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/documents/{{documentFileName}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 Negative authorization tests",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Protected route rejects missing token\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer token -> 403 (login customer first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/documents",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Customer cannot access staff documents\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}